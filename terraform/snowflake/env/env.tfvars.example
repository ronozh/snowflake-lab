# Copy to dev.tfvars / prod.tfvars (gitignored).
env                    = "dev"
warehouse_credit_quota = 10 # prod: 20
data_retention_days    = 1  # prod: 7
deploy_public_key      = "<base64 body of ~/.snowflake/keys/snowlab_dev_deploy_svc.pub>"
human_user             = "<your snowflake user name>"
human_user_roles       = ["TRANSFORMER"] # prod: ["ANALYST"]
# Optional: other Snowflake accounts' integrations that share the S3 role (DESC INTEGRATION in that account).
# extra_snowflake_trust = [{ iam_user_arn = "arn:aws:iam::<snowflake aws acct>:user/<id>", external_id = "<STORAGE_AWS_EXTERNAL_ID>" }]
