# Copy to .env (gitignored), then: set -a; source terraform/snowflake/.env; set +a
# (Sourced as shell, so the unset at the end runs.)
# Same SNOWFLAKE_* variables CI sets from GitHub environment secrets/variables.
SNOWFLAKE_ORGANIZATION_NAME=<org>
SNOWFLAKE_ACCOUNT_NAME=<account>
SNOWFLAKE_USER=TERRAFORM_SVC
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_PRIVATE_KEY="$(cat ~/.snowflake/keys/terraform_svc.p8)"
unset SNOWFLAKE_PASSWORD  # key-pair only; a password in the shell profile conflicts
